# Sao chep file nay thanh .env va dien gia tri that.
# .env da duoc gitignore -> khong bao gio commit.

# SQLite: file app.db nam o thu muc goc du an
DATABASE_URL=sqlite:///./app.db

# Sinh khoa ngau nhien: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
