Subject: fix(tech-tags): nhan ca { items: [...] } va mang tran

Backend doi response cua GET /tech-tags tu mang tran sang { items: [...] }
theo sheet API詳細 (PR #16). listTechTags() dang tra thang response.json()
nen setTechOptions nhan object thay vi mang -> dropdown loc cong nghe trong.

Ap dung trong thu muc goc cua repo frontend:
    git apply <duong-dan>/frontend-tech-tags.patch

---
diff --git a/src/lib/projectsApi.ts b/src/lib/projectsApi.ts
index 30b3980..8f313cc 100644
--- a/src/lib/projectsApi.ts
+++ b/src/lib/projectsApi.ts
@@ -139,5 +139,8 @@ export async function listTechTags(q?: string): Promise<string[]> {
   if (!response.ok) {
     throw new Error("技術タグの取得に失敗しました");
   }
-  return response.json();
+  // Backend trả { items: [...] } theo sheet API詳細; chấp nhận cả mảng trần cho bản cũ.
+  const data: unknown = await response.json();
+  if (Array.isArray(data)) return data as string[];
+  return ((data as { items?: string[] }).items ?? []);
 }
